{
  "name": "ProyectoTGS",
  "type": "module",
  "version": "0.1",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "bunx --bun astro dev --background",
    "dev:stop": "bunx --bun astro dev stop",
    "dev:status": "bunx --bun astro dev status",
    "dev:logs": "bunx --bun astro dev logs",
    "check": "bunx --bun astro check",
    "build": "bunx --bun astro build",
    "preview": "bunx --bun astro preview",
    "deploy": "bun run build && bunx --bun wrangler pages deploy dist --project-name=proyectotgs",
    "astro": "bunx --bun astro"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "astro": "7.1.6"
  },
  "overrides": {
    "vite": "8.1.3",
    "rolldown": "1.1.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "typescript": "~5.9.3",
    "wrangler": "^4.162.0"
  }
}
