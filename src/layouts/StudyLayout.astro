---
import StudyFooter from '../components/StudyFooter.astro';
import { studyLinks } from '../data/info';
import type { StudyLayoutProps } from '../data/info';
import '../styles/styles.css';

type Props = StudyLayoutProps;
const { title, description } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, '');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#065c67" />
    <link rel="icon" href="https://uniguajira.edu.co/wp-content/uploads/2023/12/cropped-cropped-Favicon-de-la-Universidad-de-La-Guajira-UNIGUAJIRA-32x32.webp" sizes="32x32" />
    <link rel="icon" href="https://uniguajira.edu.co/wp-content/uploads/2023/12/cropped-cropped-Favicon-de-la-Universidad-de-La-Guajira-UNIGUAJIRA-192x192.webp" sizes="192x192" />
    <link rel="apple-touch-icon" href="https://uniguajira.edu.co/wp-content/uploads/2023/12/cropped-cropped-Favicon-de-la-Universidad-de-La-Guajira-UNIGUAJIRA-180x180.webp" />
    <meta name="msapplication-TileImage" content="https://uniguajira.edu.co/wp-content/uploads/2023/12/cropped-cropped-Favicon-de-la-Universidad-de-La-Guajira-UNIGUAJIRA-270x270.webp" />
    <title>{title}</title>
  </head>
  <body id="inicio">
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/" aria-label="Universidad de La Guajira · Inicio del proyecto">
          <img src="/logo-pagina.webp" width="360" height="72" alt="Universidad de La Guajira" />
        </a>
        <nav class="primary-nav" aria-label="Navegación principal">
          {studyLinks.map(({ href, title }) => (
            <a href={href} aria-current={currentPath === href.slice(0, -1) ? 'page' : undefined}>{title}</a>
          ))}
        </nav>
      </div>
    </header>

    <main id="contenido" tabindex="-1">
      <slot />
    </main>

    <StudyFooter />
    <script>
      import '../scripts/effects';
    </script>
  </body>
</html>
