---
import StudyLayout from '../../layouts/StudyLayout.astro';
import { topics, unitThreeFullTitle } from '../../data/info';
---

<StudyLayout
  title={`${unitThreeFullTitle} · Unidad 3`}
  description="Temario de la Unidad 3 de Teoría General de Sistemas. Explora clasificación, elementos y propiedades."
>
  <article class="wrap study-page">
    <a class="unit-link" href="/">← Guía de estudio</a>
    <p class="eyebrow">Unidad 03</p>
    <h1 class="portal-heading">{unitThreeFullTitle}</h1>
    <p class="lead">Aprende a distinguir tipos de sistemas, identificar sus elementos y explicar cómo sus partes interactúan.</p>

    <h2 class="index-heading">Temario de la unidad</h2>
    <ol class="study-route" role="list">
      {topics.map(({ id, number, title, intro }) => (
        <li>
          <span class="topic-number" aria-hidden="true">{number}</span>
          <div>
            <h3><a href={`/unidad-3/${id}/`}>{title}</a></h3>
            <p>{intro}</p>
          </div>
        </li>
      ))}
    </ol>

    <p class="study-source">Para repasar cómo se delimita y se representa un sistema, vuelve a los <a href="/fundamentos/">fundamentos</a>.</p>
    <a class="button" href="/unidad-3/clasificacion/">Empezar por clasificación <span aria-hidden="true">→</span></a>
  </article>
</StudyLayout>
