---
import StudyFlow from '../../components/StudyFlow.astro';
import StudyLayout from '../../layouts/StudyLayout.astro';
import { article, classificationMatrix, topicFlows, topics, unitThreeTitle } from '../../data/info';
import type { TopicPageProps } from '../../data/info';

export function getStaticPaths() {
  return topics.map((topic) => ({ params: { tema: topic.id }, props: { topic } }));
}

type Props = TopicPageProps;
const { topic } = Astro.props;
const next = topics[topics.findIndex(({ id }) => id === topic.id) + 1];
const flow = topicFlows[topic.id];
---

<StudyLayout title={`${topic.title} · ${unitThreeTitle}`} description={topic.intro}>
  <article class="wrap study-page">
    <a class="unit-link" href="/unidad-3/">← {unitThreeTitle}</a>
    <p class="eyebrow">Unidad 03 · Tema {topic.number}</p>
    <h1 class="portal-heading">{topic.title}</h1>
    <p class="lead">{topic.intro}</p>

    {topic.id === 'clasificacion' && (
      <table class="study-matrix">
        <caption>Criterios para clasificar un sistema</caption>
        <thead><tr><th scope="col">Criterio</th><th scope="col">Categorías</th><th scope="col">Ejemplo o distinción</th></tr></thead>
        <tbody>
          {classificationMatrix.map(([criterion, categories, example]) => (
            <tr><th scope="row">{criterion}</th><td>{categories}</td><td>{example}</td></tr>
          ))}
        </tbody>
      </table>
    )}

    {flow && <StudyFlow {...flow} />}

    <div class="reading-details">
      {topic.items.map(([term, definition]) => (
        <section class="reading-section"><h2>{term}</h2><p>{definition}</p></section>
      ))}
    </div>

    <p class="study-source">Lectura base · <a href={article.url}>{article.title}</a>. Sección {topic.articleSection}. <a href={article.pdf}>Ver PDF</a>.</p>
    {topic.reference && <p class="study-source">Material de apoyo · <a href={topic.reference.href}>{topic.reference.title} (PDF)</a></p>}
    <a class="button" href={next ? `/unidad-3/${next.id}/` : '/caso-de-estudio/'}>
      {next ? next.title : 'Ver el caso de estudio'} <span aria-hidden="true">→</span>
    </a>
  </article>
</StudyLayout>
