---
import { article, caseGuide, projectTeam, publicResources, unitThreeFullTitle, unitThreeSupport } from '../data/info';
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <div class="footer-grid">
      <section class="footer-panel" aria-labelledby="footer-grupo">
        <h2 id="footer-grupo">Grupo 2 · Integrantes</h2>
        <ul class="footer-list footer-team" role="list">
          {projectTeam.map((name) => <li>{name}</li>)}
        </ul>
        <div class="footer-course">
          <p><strong>Teoría de Sistemas</strong></p>
          <p>Proyecto final · {unitThreeFullTitle}</p>
          <p>Docente · Katy Herrera</p>
          <p>Facultad de Ingeniería, Universidad de la Guajira</p>
        </div>
      </section>

      <section class="footer-panel" aria-labelledby="footer-recursos">
        <h2 id="footer-recursos">Recursos del proyecto</h2>
        <ul class="footer-list footer-resources" role="list">
          {publicResources.map(({ title, href }) => <li><a href={href}>{title}</a></li>)}
        </ul>
      </section>

      <section class="footer-panel" aria-labelledby="footer-referencias">
        <h2 id="footer-referencias">Referencias</h2>
        <ul class="footer-list footer-resources" role="list">
          <li><a href={article.pdf}>{article.title} (PDF)</a></li>
          <li><a href="https://www.journals.uchicago.edu/doi/10.1093/bjps/I.2.134">Ludwig von Bertalanffy (1950), An Outline of General System Theory</a></li>
          <li><a href="https://uniguajira.edu.co/actualidad/manual-de-identidad/">Manual de identidad visual de Uniguajira</a></li>
          <li><a href={unitThreeSupport.href}>{unitThreeSupport.title} (PDF)</a></li>
          <li><a href={caseGuide.href}>{caseGuide.title} (DOCX)</a></li>
        </ul>
      </section>
    </div>

    <div class="footer-bottom">
      <a href="https://uniguajira.edu.co/">Portal oficial de Uniguajira <span aria-hidden="true">↗</span></a>
      <a href="#inicio">Volver arriba <span aria-hidden="true">↑</span></a>
    </div>
  </div>
</footer>
