<figure class="diagram">
  <div class="diagram-graphic">
    <svg viewBox="0 0 390 208" role="img" aria-labelledby="diagram-title diagram-desc">
      <title id="diagram-title">Flujo de un sistema con retroalimentación</title>
      <desc id="diagram-desc">Las entradas pasan por un proceso y generan salidas. La información sobre las salidas vuelve al proceso mediante retroalimentación.</desc>
      <defs>
        <marker id="arrow" markerWidth="7" markerHeight="7" refX="6" refY="3.5" orient="auto">
          <path d="M0 0 7 3.5 0 7Z" class="diagram-accent" />
        </marker>
      </defs>
      <rect x="115" y="29" width="160" height="151" rx="12" fill="none" class="diagram-boundary" stroke-dasharray="5 5" />
      <text x="195" y="53" class="diagram-label">Límite del sistema</text>
      <g fill="none" class="diagram-flow" stroke-width="2" marker-end="url(#arrow)">
        <path d="M93 103H139" />
        <path d="M250 103H296" />
        <path d="M342 126V158H195V127" />
      </g>
      <rect x="3" y="80" width="90" height="46" rx="7" class="diagram-box" />
      <rect x="140" y="80" width="110" height="46" rx="7" class="diagram-accent" />
      <rect x="297" y="80" width="90" height="46" rx="7" class="diagram-box" />
      <text x="48" y="108">Entradas</text>
      <text x="195" y="108" class="diagram-process">Proceso</text>
      <text x="342" y="108">Salidas</text>
      <text x="267" y="199" class="diagram-label">Retroalimentación</text>
    </svg>
  </div>
  <figcaption><span>FIG. 01</span> Modelo de un sistema</figcaption>
</figure>
