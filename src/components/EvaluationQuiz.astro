---
import { evaluationQuestions } from '../data/evaluation';
---

<section class="test evaluation-test" aria-labelledby="test-titulo">
  <div>
    <h2 id="test-titulo" class="index-heading">Test de autoevaluación</h2>
    <p>Responde las 20 preguntas para conocer tu resultado.</p>
  </div>

  <form class="evaluation-form" data-evaluation-form>
    <ol class="evaluation-questions">
      {evaluationQuestions.map(({ prompt, options }, questionIndex) => (
        <li>
          <fieldset class="evaluation-question">
            <legend>
              <span class="evaluation-question-number">Pregunta {questionIndex + 1}</span>
              <span>{prompt}</span>
            </legend>
            <div class="evaluation-options">
              {options.map((option, optionIndex) => (
                <label for={`question-${questionIndex}-${optionIndex}`}>
                  <input
                    id={`question-${questionIndex}-${optionIndex}`}
                    type="radio"
                    name={`question-${questionIndex}`}
                    value={optionIndex}
                    required
                  />
                  <span>{option}</span>
                </label>
              ))}
            </div>
          </fieldset>
        </li>
      ))}
    </ol>

    <p class="evaluation-progress" data-evaluation-progress aria-live="polite">
      Respuestas: 0 de {evaluationQuestions.length}. El botón se habilita al responder todas las preguntas.
    </p>
    <button class="button" type="submit" data-evaluation-submit disabled>Finalizar evaluación</button>
  </form>

  <section class="evaluation-result" data-evaluation-result aria-labelledby="evaluation-result-title" aria-live="polite" hidden>
    <h2 id="evaluation-result-title" class="index-heading">Puntaje obtenido</h2>
    <p class="evaluation-score" data-evaluation-score></p>
    <p data-evaluation-message></p>
    <button class="button" type="button" data-evaluation-retry>Intentar nuevamente</button>
  </section>
</section>

<script>
  import { evaluationQuestions } from '../data/evaluation';

  const form = document.querySelector<HTMLFormElement>('[data-evaluation-form]');
  const submitButton = document.querySelector<HTMLButtonElement>('[data-evaluation-submit]');
  const progress = document.querySelector<HTMLElement>('[data-evaluation-progress]');
  const result = document.querySelector<HTMLElement>('[data-evaluation-result]');
  const scoreOutput = document.querySelector<HTMLElement>('[data-evaluation-score]');
  const messageOutput = document.querySelector<HTMLElement>('[data-evaluation-message]');
  const retryButton = document.querySelector<HTMLButtonElement>('[data-evaluation-retry]');

  if (form && submitButton && progress && result && scoreOutput && messageOutput && retryButton) {
    form.addEventListener('change', () => {
      const responses = new FormData(form);
      const answered = evaluationQuestions.reduce(
        (total, _, index) => total + (responses.has(`question-${index}`) ? 1 : 0),
        0,
      );

      submitButton.disabled = answered !== evaluationQuestions.length;
      progress.textContent = `Respuestas: ${answered} de ${evaluationQuestions.length}. ${
        answered === evaluationQuestions.length
          ? 'Ya puedes finalizar la evaluación.'
          : 'El botón se habilita al responder todas las preguntas.'
      }`;
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();

      if (!form.reportValidity()) return;

      const responses = new FormData(form);
      const correct = evaluationQuestions.reduce(
        (total, question, index) =>
          total + (responses.get(`question-${index}`) === String(question.answer) ? 1 : 0),
        0,
      );
      const percentage = (correct / evaluationQuestions.length) * 100;
      const message =
        percentage >= 90
          ? 'Excelente dominio del tema.'
          : percentage >= 70
            ? 'Buen trabajo. Revisa algunos conceptos para mejorar.'
            : percentage >= 50
              ? 'Necesitas reforzar varios temas.'
              : 'Se recomienda estudiar nuevamente el contenido antes de volver a intentarlo.';

      scoreOutput.textContent = `${correct} / ${evaluationQuestions.length} · ${percentage}%`;
      messageOutput.textContent = message;
      result.hidden = false;
      result.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });

    retryButton.addEventListener('click', () => {
      form.reset();
      submitButton.disabled = true;
      progress.textContent = `Respuestas: 0 de ${evaluationQuestions.length}. El botón se habilita al responder todas las preguntas.`;
      result.hidden = true;
      form.querySelector<HTMLInputElement>('input[type="radio"]')?.focus();
    });
  }
</script>
