---
import StudyFlow from './StudyFlow.astro';
import { article, foundations, resolutionFlow, structureFlow, unitThreeTitle } from '../data/info';
---

<article class="wrap study-page">
  <a class="unit-link" href="/">← Guía de estudio</a>
  <p class="eyebrow">Lectura introductoria</p>
  <h1 class="portal-heading">Fundamentos de la Teoría General de Sistemas</h1>
  <p class="lead">Una plataforma de matrícula sirve de ejemplo para ver cómo las partes se organizan, cómo cambia el sistema y qué conviene incluir en el análisis.</p>

  {foundations.map(({ id, title, text }) => (
    <section id={id} class="reading-section">
      <h2>{title}</h2>
      <p>{text}</p>
      {id === 'estructura' && <StudyFlow {...structureFlow} />}
      {id === 'resolucion' && <StudyFlow {...resolutionFlow} />}
      {id === 'umbrales' && (
        <figure class="study-figure threshold">
          <figcaption>Umbral en la asignación de cupos</figcaption>
          <div class="threshold-track">
            <span>Hay cupos<br /><strong>Inscripción disponible</strong></span>
            <span class="threshold-marker">0 cupos</span>
            <span>Cupos agotados<br /><strong>Lista de espera</strong></span>
          </div>
          <p>Esquema de ejemplo. El umbral cambia el tipo de respuesta que recibe la solicitud.</p>
        </figure>
      )}
    </section>
  ))}

  <p class="study-source">Lectura base · <a href={article.url}>{article.title}</a>. Apartados 2–5 y 8–10. <a href={article.pdf}>Ver PDF</a>.</p>
  <a class="button" href="/unidad-3/">{unitThreeTitle} <span aria-hidden="true">→</span></a>
</article>
